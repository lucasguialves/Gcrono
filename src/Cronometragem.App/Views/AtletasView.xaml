<UserControl x:Class="Cronometragem.App.Views.AtletasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" FontWeight="Bold" FontSize="14"
                   Text="{Binding ProvaAtiva.Nome, StringFormat='Prova ativa: {0}', FallbackValue='Nenhuma prova ativa selecionada', TargetNullValue='Nenhuma prova ativa selecionada'}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: cadastro geral de atletas -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Atletas (cadastro geral)" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Excluir todos" Padding="8,4"
                            Style="{StaticResource BotaoPerigo}"
                            Command="{Binding ExcluirTodosAtletasCommand}" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="Nome" />
                    <TextBox Text="{Binding NovoNomeAtleta, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Text="Documento (CPF/RG)" />
                    <TextBox Text="{Binding NovoDocumento, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data de nascimento" />
                            <DatePicker SelectedDate="{Binding NovaDataNascimento}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sexo" />
                            <ComboBox ItemsSource="{Binding OpcoesSexo}" SelectedItem="{Binding NovoSexo}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Cadastrar atleta" Padding="8,4" HorizontalAlignment="Left"
                            Command="{Binding CriarAtletaCommand}" />
                    <TextBlock Text="Dica: dê duplo-clique num atleta na lista abaixo para editar os dados."
                               FontStyle="Italic" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="A data de nascimento é usada para encaixar o atleta automaticamente na categoria certa na hora de inscrever."
                               FontStyle="Italic" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid x:Name="GradeAtletas" ItemsSource="{Binding Atletas}" AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="GradeAtletas_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="100" />
                        <DataGridTextColumn Header="Nascimento" Binding="{Binding DataNascimento}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Coluna direita: inscrições na prova ativa (categorias/modalidades são cadastradas na aba Provas) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="Inscrições (peito + chip)" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontStyle="Italic" Foreground="Gray"
                               Text="A categoria é definida automaticamente pela idade do atleta (cadastre a data de nascimento e as categorias da prova na aba Provas)." TextWrapping="Wrap" />

                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Margin="0,0,4,0"
                                  ItemsSource="{Binding Atletas}" DisplayMemberPath="Nome"
                                  SelectedItem="{Binding AtletaSelecionadoParaInscricao}" />
                        <TextBox Grid.Column="1" Margin="0,0,4,0"
                                 Text="{Binding NovoNumeroPeito, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Número de peito" />
                        <TextBox Grid.Column="2" Margin="0,0,4,0"
                                 Text="{Binding NovoChipId, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Identificador do chip" />
                        <ComboBox Grid.Column="3" Margin="0,0,4,0"
                                  ItemsSource="{Binding Modalidades}" DisplayMemberPath="Nome"
                                  SelectedItem="{Binding ModalidadeSelecionadaParaInscricao}"
                                  ToolTip="Modalidade" />
                        <Button Grid.Column="4" Content="Inscrever" Padding="8,4"
                                Command="{Binding CriarInscricaoCommand}" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding Inscricoes}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Peito" Binding="{Binding Inscricao.NumeroPeito}" Width="70" />
                            <DataGridTextColumn Header="Atleta" Binding="{Binding NomeAtleta}" Width="*" />
                            <DataGridTextColumn Header="Chip" Binding="{Binding Inscricao.ChipId}" Width="100" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding NomeCategoria}" Width="100" />
                            <DataGridTextColumn Header="Modalidade" Binding="{Binding NomeModalidade}" Width="100" />
                            <DataGridTemplateColumn Header="Ações" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remover" Padding="6,2"
                                                Command="{Binding DataContext.ExcluirInscricaoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
