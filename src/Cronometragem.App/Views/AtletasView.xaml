<UserControl x:Class="Cronometragem.App.Views.AtletasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,10" FontWeight="Bold" FontSize="14"
                   Text="{Binding ProvaAtiva.Nome, StringFormat='Prova ativa: {0}', FallbackValue='Nenhuma prova ativa selecionada', TargetNullValue='Nenhuma prova ativa selecionada'}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Coluna esquerda: cadastro geral de atletas -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Atletas (cadastro geral)" FontWeight="Bold" Margin="0,0,0,8" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="Nome" />
                    <TextBox Text="{Binding NovoNomeAtleta, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Text="Documento (CPF/RG)" />
                    <TextBox Text="{Binding NovoDocumento, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <Button Content="Cadastrar atleta" Padding="8,4" HorizontalAlignment="Left"
                            Command="{Binding CriarAtletaCommand}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Atletas}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                        <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Coluna direita: categorias e inscrições na prova ativa -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Expander Grid.Row="0" Header="Categorias da prova" Margin="0,0,0,10">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Categorias}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nome}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Margin="0,0,4,0"
                                     Text="{Binding NovoNomeCategoria, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Nome da categoria" />
                            <TextBox Grid.Column="1" Margin="0,0,4,0"
                                     Text="{Binding NovaIdadeMin, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Idade mínima" />
                            <TextBox Grid.Column="2" Margin="0,0,4,0"
                                     Text="{Binding NovaIdadeMax, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Idade máxima" />
                            <Button Grid.Column="3" Content="Adicionar" Padding="8,4"
                                    Command="{Binding CriarCategoriaCommand}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Top" Text="Inscrições (peito + chip)" FontWeight="Bold" Margin="0,0,0,8" />

                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Margin="0,0,4,0"
                                  ItemsSource="{Binding Atletas}" DisplayMemberPath="Nome"
                                  SelectedItem="{Binding AtletaSelecionadoParaInscricao}" />
                        <TextBox Grid.Column="1" Margin="0,0,4,0"
                                 Text="{Binding NovoNumeroPeito, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Número de peito" />
                        <TextBox Grid.Column="2" Margin="0,0,4,0"
                                 Text="{Binding NovoChipId, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Identificador do chip" />
                        <ComboBox Grid.Column="3" Margin="0,0,4,0"
                                  ItemsSource="{Binding Categorias}" DisplayMemberPath="Nome"
                                  SelectedItem="{Binding CategoriaSelecionadaParaInscricao}" />
                        <Button Grid.Column="4" Content="Inscrever" Padding="8,4"
                                Command="{Binding CriarInscricaoCommand}" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding Inscricoes}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Peito" Binding="{Binding Inscricao.NumeroPeito}" Width="70" />
                            <DataGridTextColumn Header="Atleta" Binding="{Binding NomeAtleta}" Width="*" />
                            <DataGridTextColumn Header="Chip" Binding="{Binding Inscricao.ChipId}" Width="100" />
                            <DataGridTextColumn Header="Categoria" Binding="{Binding NomeCategoria}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
