<UserControl x:Class="Cronometragem.App.Views.ConfiguracaoLeitoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Adicionar leitor simulado (hardware real ainda não definido)" Margin="0,0,0,10">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0"
                         Text="{Binding NovoNomeLeitor, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Nome do leitor (ex.: Antena Largada 1)" />
                <ComboBox Grid.Column="1" Margin="0,0,8,0"
                          ItemsSource="{Binding PontosControleDisponiveis}"
                          SelectedItem="{Binding NovoPontoControle}" />
                <Button Grid.Column="2" Content="Adicionar leitor" Padding="8,4"
                        Command="{Binding AdicionarLeitorSimuladoCommand}" />
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Leitores}" SelectedItem="{Binding LeitorSelecionado}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" />
                <DataGridTextColumn Header="Ponto de controle" Binding="{Binding PontoControle}" Width="140" />
                <DataGridCheckBoxColumn Header="Conectado" Binding="{Binding Conectado}" Width="90" />
                <DataGridTemplateColumn Header="Ações" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Conectar" Margin="0,0,4,0" Padding="6,2"
                                        Command="{Binding DataContext.ConectarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Desconectar" Padding="6,2"
                                        Command="{Binding DataContext.DesconectarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="Simular leitura (leitor selecionado na lista acima precisa estar conectado)" Margin="0,10,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,8,0"
                         Text="{Binding ChipParaSimular, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Identificador do chip a simular" />
                <Button Grid.Column="1" Content="Simular leitura agora" Padding="8,4"
                        Command="{Binding SimularLeituraCommand}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
