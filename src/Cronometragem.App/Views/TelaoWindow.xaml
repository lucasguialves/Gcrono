<Window x:Class="Cronometragem.App.Views.TelaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telão — Chegadas" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#0A0E14">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#2F80ED" Text="CHEGADAS" />
            <TextBlock FontSize="34" FontWeight="Bold" Foreground="White"
                       Text="{Binding ProvaAtiva.Nome, FallbackValue='Nenhuma prova ativa', TargetNullValue='Nenhuma prova ativa'}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Chegadas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1F28" CornerRadius="10" Padding="22,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#2F80ED" CornerRadius="8"
                                        Width="84" Height="84" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PosicaoGeral, StringFormat='{}{0}º'}"
                                               FontSize="30" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NomeAtleta}" FontSize="32" FontWeight="Bold" Foreground="White" />
                                    <TextBlock FontSize="18" Foreground="#9AA5B1" Margin="0,4,0,0">
                                        <Run Text="{Binding NomeModalidade, Mode=OneWay}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding NomeCategoria, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="2" FontSize="38" FontWeight="Bold" Foreground="#2F80ED"
                                           VerticalAlignment="Center"
                                           Text="{Binding Tempo, StringFormat='{}{0:hh\\:mm\\:ss}'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
