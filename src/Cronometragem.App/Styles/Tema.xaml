<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta de cores (tema escuro) -->
    <SolidColorBrush x:Key="CorPrimaria" Color="#2F80ED" />
    <SolidColorBrush x:Key="CorPrimariaEscura" Color="#1C5FC2" />
    <SolidColorBrush x:Key="CorPrimariaClara" Color="#243352" />
    <SolidColorBrush x:Key="CorFundoJanela" Color="#121417" />
    <SolidColorBrush x:Key="CorSuperficie" Color="#1E222A" />
    <SolidColorBrush x:Key="CorBranco" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CorTextoPrincipal" Color="#E8EAED" />
    <SolidColorBrush x:Key="CorTextoSecundario" Color="#9AA5B1" />
    <SolidColorBrush x:Key="CorBorda" Color="#333842" />
    <SolidColorBrush x:Key="CorLinhaAlternada" Color="#262B35" />

    <!-- Janela -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource CorFundoJanela}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource CorTextoPrincipal}" />
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource CorFundoJanela}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource CorTextoPrincipal}" />
    </Style>

    <!-- Texto -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
    </Style>

    <!-- Botão -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CorPrimaria}" />
        <Setter Property="Foreground" Value="{StaticResource CorBranco}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPrimariaEscura}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPrimariaEscura}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorBorda}" />
                            <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão secundário (ex.: Cancelar) -->
    <Style x:Key="BotaoSecundario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{StaticResource CorPrimaria}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPrimariaClara}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de ação destrutiva (ex.: excluir tudo) -->
    <Style x:Key="BotaoPerigo" TargetType="Button">
        <Setter Property="Background" Value="#C0392B" />
        <Setter Property="Foreground" Value="{StaticResource CorBranco}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#962D22" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                            <Setter TargetName="Fundo" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorFundoJanela}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Itens da lista suspensa do ComboBox -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fundo" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPrimariaClara}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPrimaria}" />
                            <Setter Property="Foreground" Value="{StaticResource CorBranco}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: template completo (o template padrão do WPF não respeita Background/Foreground
         nem na caixa fechada nem na lista suspensa, deixando texto branco sobre fundo branco) -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{StaticResource CorSuperficie}"
                                            BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0 Z"
                                                  Fill="{StaticResource CorTextoSecundario}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}"
                                    BorderThickness="1" CornerRadius="3" MaxHeight="300"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker: a caixa de texto interna (DatePickerTextBox) tem template próprio e
         precisa ser estilizada separadamente, senão fica com fundo branco. -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- DatePickerTextBox herda de TextBox: o template usa PART_ContentHost, igual a uma TextBox comum. -->
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            <ContentControl x:Name="PART_Watermark" Focusable="False" IsHitTestVisible="False"
                                            Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                            Foreground="{StaticResource CorTextoSecundario}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Calendário do DatePicker -->
    <Style TargetType="CalendarItem">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
    </Style>

    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
    </Style>

    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource CorPrimaria}" />
                <Setter Property="Foreground" Value="{StaticResource CorBranco}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CorPrimariaClara}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CorPrimariaClara}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- TabControl / TabItem: barra de navegação estilo "underline" -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource CorFundoJanela}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Fundo" Background="{StaticResource CorSuperficie}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource CorPrimaria}" />
                            <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorPrimariaClara}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="RowBackground" Value="{StaticResource CorSuperficie}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource CorLinhaAlternada}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource CorPrimaria}" />
        <Setter Property="Foreground" Value="{StaticResource CorBranco}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource CorPrimariaEscura}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource CorPrimariaClara}" />
                <Setter Property="Foreground" Value="{StaticResource CorTextoPrincipal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GroupBox: cartão simples -->
    <Style TargetType="GroupBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}"
                            BorderThickness="1" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Header}" FontWeight="Bold"
                                       Foreground="{StaticResource CorPrimaria}" Margin="0,0,0,8" />
                            <ContentPresenter />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander -->
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
    </Style>

</ResourceDictionary>
